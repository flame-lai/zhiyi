# Copy to deploy/.env before production deployment.
COMPOSE_PROJECT_NAME=zhiyi-erp

# Pull latest code before `scripts/deploy.sh deploy`.
# Keep this true on the production server unless you deploy from a local checkout intentionally.
AUTO_GIT_PULL=true
GIT_REMOTE=origin
GIT_BRANCH=main

# Public web/API entry. If TLS is terminated by CDN/SLB, keep HTTP_PORT=80 here.
SERVER_NAME=erp.example.com
HTTP_PORT=80
CLIENT_MAX_BODY_SIZE=50m

# Data services.
# Use "container" to start MySQL/Redis with Docker Compose.
# Use "host" when MySQL/Redis already run on the host machine.
DATA_SERVICES=container

# MySQL.
# For DATA_SERVICES=host on Linux Docker, use MYSQL_HOST=host.docker.internal.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=zhiyi_erp
MYSQL_USER=zhiyi
MYSQL_PASSWORD=change_me_db_password

# Redis.
# For DATA_SERVICES=host on Linux Docker, use REDIS_HOST=host.docker.internal.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Backend JVM options
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# Mini program build. The value must be HTTPS for WeChat production release.
BUILD_MINI=true
MINI_API_BASE_URL=https://erp.example.com/api
